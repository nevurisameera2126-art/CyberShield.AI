rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access across all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and settings: Only the authenticated owner can read or write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Scans subcollection: Strictly accessible only by the owner
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Quiz progress subcollection: Strictly accessible only by the owner
      match /quizzes/{quizId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
